# KEZA — backend provider keys (server-side only; NEVER exposed to the browser)
#
# Local dev: copy this file to `.env.local` (or `.env`) and fill in what you have.
# Vercel:   Project ▸ Settings ▸ Environment Variables ▸ Add — use these exact NAMES.
#           Set them for Production / Preview / Development. Redeploy after adding.
#
# A provider becomes selectable in the app the moment its key is present.
# Set only the ones you use; leave the rest unset (or delete the lines).

# --- OpenAI (also powers the "OpenAI Codex" provider + voice TTS) ---
OPENAI_API_KEY=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- NVIDIA (build.nvidia.com / NIM) ---
NVIDIA_API_KEY=

# --- Google Gemini (AI Studio key; also powers Gemini voice TTS) ---
GEMINI_API_KEY=

# --- OpenRouter (many models, one key) ---
OPENROUTER_API_KEY=

# --- Alibaba Cloud Model Studio / DashScope (Qwen) ---
ALIBABA_API_KEY=

# --- Free-LLM (any OpenAI-compatible endpoint; default is Groq) ---
FREE_LLM_API_KEY=
# Optional: point Free-LLM at a different OpenAI-compatible base URL.
# Examples: https://api.groq.com/openai/v1  |  https://api.openai.com/v1  |  http://localhost:11434/v1
FREE_LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Optional base-URL overrides (only if you use a proxy / regional endpoint) ---
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# NVIDIA_BASE_URL=
# GEMINI_BASE_URL=
# OPENROUTER_BASE_URL=
# ALIBABA_BASE_URL=
